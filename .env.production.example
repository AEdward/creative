# Production settings for creativelabet.com on Yegara cPanel.
# Copy to .env on the server, then fill in every value marked CHANGE (never commit the real .env).
APP_NAME="Creative Lab Academy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://creativelabet.com

# Private address of the admin panel: https://creativelabet.com/<ADMIN_PATH>. Pick something hard to guess.
ADMIN_PATH=CHANGE_ME_admin_path

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# cPanel -> MySQL Databases. cPanel prefixes names with your account user, e.g. acct_creative.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_cpaneluser_creative
DB_USERNAME=CHANGE_cpaneluser_creative
DB_PASSWORD=CHANGE

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Yegara email: cPanel -> Email Accounts -> create noreply@creativelabet.com.
# "Connect Devices" in cPanel shows the exact outgoing server; it is normally mail.creativelabet.com,
# port 465 with SSL (scheme smtps). Use 587 + MAIL_SCHEME=smtp only if 465 is blocked.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.creativelabet.com
MAIL_PORT=465
MAIL_USERNAME=noreply@creativelabet.com
MAIL_PASSWORD=CHANGE
MAIL_FROM_ADDRESS="noreply@creativelabet.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Integrations stay off until configured and verified.
PAYMENTS_ENABLED=false
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto

# Full path if mysqldump isn't on the PATH in cron (check with: which mysqldump)
MYSQLDUMP_PATH=/usr/bin/mysqldump
